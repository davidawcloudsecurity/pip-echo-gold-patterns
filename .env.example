# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Required: OpenRouter API key.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Required: Twelve Data API key for XAU/USD spot gold OHLC data.
# Get a free key at https://twelvedata.com (no credit card needed).
TWELVEDATA_API_KEY=

# Optional: override the Twelve Data symbol for historical data.
# Default: XAU/USD (Gold Spot / US Dollar)
# XAU_SYMBOL=XAU/USD
